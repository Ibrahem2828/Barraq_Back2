:8080 {
    encode zstd gzip
    request_body {
        max_size 64MB
    }

    # Access logs to stdout so the json-file driver collects them with
    # everything else. Without this, Caddy logs only errors and the edge --
    # the one place every request is visible -- contributes nothing to an
    # incident timeline.
    log {
        output stdout
        format json
    }

    # Liveness for the container healthcheck. Declared before the host
    # matchers so it answers regardless of Host, which is what a healthcheck
    # dialling 127.0.0.1 inside the container needs. It reveals nothing and
    # touches no upstream: it proves this listener is serving, not that the
    # applications behind it are.
    @gateway_health path /__gateway_health
    handle @gateway_health {
        respond "ok" 200
    }

    header {
        -Server
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options "DENY"
    }

    @website host baraqapp.com
    handle @website {
        reverse_proxy website:4173 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_down -Server
        }
    }

    @www host www.baraqapp.com
    handle @www {
        redir https://baraqapp.com{uri} permanent
    }

    @api host api.baraqapp.com
    handle @api {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_down -Server
        }
    }

    @dashboard host dashboard.baraqapp.com
    handle @dashboard {
        reverse_proxy dashboard:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_down -Server
        }
    }

    # `ai.baraqapp.com` used to be forwarded through a loopback compatibility
    # port by a host-level proxy outside this repository.  The AI service is
    # private; make that legacy host an intentional non-route instead of
    # relying on the generic fallback or exposing ai-api on the edge network.
    @private_ai host ai.baraqapp.com
    handle @private_ai {
        respond "not found" 404
    }

    respond "Unknown Baraq host" 404
}

:8084 {
    encode zstd gzip
    request_body {
        max_size 64MB
    }
    header -Server

    log {
        output stdout
        format json
    }

    reverse_proxy web:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_down -Server
    }
}
