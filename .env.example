# Baraq backend environment -- Django/pydantic-style variable names, for a
# STANDALONE run of this one service (`python manage.py runserver`, or this
# repo's own `docker-compose.yml`/`docker-compose.local.yml`).
#
# For the actual deployed stack (root `compose.yaml`, orchestrating backend +
# AI + dashboard + website behind one Caddy gateway), THIS file is not what
# gets loaded -- compose sets every one of these variables itself, computed
# from `D:\baraaq\.env.example`'s much shorter CHANGE_ME list (via the
# `x-backend-environment` anchor in compose.yaml). Use that root file as the
# single source of truth for a real deployment; use this one for local/
# standalone development and to see every variable name this codebase
# actually reads (`config/settings.py`).
#
# Never commit a real, filled-in copy of either file.
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=replace-with-a-random-secret-of-at-least-64-characters
# Django's own admin path. Use a non-guessable value in production
# (e.g. control-<random>/); the dashboard uses /api/v1/admin/ regardless.
DJANGO_ADMIN_URL=admin/
# Adjust these three to the real subdomains your reverse proxy (Caddy) routes
# to this container -- the values below assume the API is reachable at
# api.baraqapp.com and the dashboard at dashboard.baraqapp.com. If instead a
# single baraqapp.com origin serves everything, list that host too/instead.
# The marketing/waitlist site (Baraq_Website) also needs its own origin
# listed in CORS_ALLOWED_ORIGINS (and CSRF_TRUSTED_ORIGINS) -- its waitlist
# form calls /api/v1/waitlist/ cross-origin, so without this the browser
# blocks the response even though the request itself succeeds.
ALLOWED_HOSTS=api.baraqapp.com,baraqapp.com,localhost,127.0.0.1
PUBLIC_API_BASE_URL=https://api.baraqapp.com
CORS_ALLOWED_ORIGINS=https://dashboard.baraqapp.com,https://baraqapp.com,https://website.baraqapp.com
CSRF_TRUSTED_ORIGINS=https://api.baraqapp.com,https://dashboard.baraqapp.com,https://baraqapp.com,https://website.baraqapp.com
TIME_ZONE=Asia/Damascus

# PostgreSQL
# For a standalone run: point this at a real, reachable Postgres (a managed
# database, or a separate container you run yourself) -- not "db" unless you
# actually have a service by that name. The real deployed stack (root
# compose.yaml) instead runs its own `backend-db` container and sets
# DATABASE_URL itself; this section is irrelevant there.
POSTGRES_DB=baraq_db
POSTGRES_USER=baraq_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://baraq_user:replace-with-a-strong-database-password@db:5432/baraq_db
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Redis / Celery
# For a standalone run: these MUST point at a real, reachable Redis instance
# (a managed Redis, or a container you run yourself) or every cache read/
# write and the /api/v1/health/ready/ probe will fail against an unreachable
# localhost. The real deployed stack (root compose.yaml) instead runs its
# own `redis` container and sets these itself; this section is irrelevant
# there. Queue separation: latency-sensitive user email (OTP, password
# reset) routes to the `critical` queue, everything else to `default` (see
# CELERY_TASK_ROUTES in config/settings.py) -- a standalone worker must
# listen on both, e.g. `celery -A config worker --queues=critical,default`.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2

# Separate AI service. The OpenAI keys belong only in the AI service, not here.
# Set this to wherever Baraq_AI is actually deployed (its own container/VPS
# entry) once that service is live -- settings.py refuses to boot with an
# http:// URL here in production, so this must be a real https:// address.
AI_SERVICE_ENABLED=True
AI_SERVICE_BASE_URL=https://ai.baraqapp.com
AI_SERVICE_JOBS_PATH=/api/ai/v1/jobs
AI_SERVICE_FEEDBACK_PATH=/api/ai/v1/feedback
AI_SERVICE_HEALTH_PATH=/api/ai/v1/health/ready
# Baraq Internal HMAC V2. Both services use the same keyring during key rotation.
BARAQ_SERVICE_ID=baraq-django
BARAQ_HMAC_CURRENT_KEY_ID=django-current
BARAQ_HMAC_KEYS_JSON={"django-current":"replace-with-a-random-hmac-secret-at-least-32-characters","django-previous":"replace-only-during-a-managed-key-rotation"}
BARAQ_HMAC_ALLOWED_SERVICES=baraq-ai-service
BARAQ_HMAC_MAX_CLOCK_SKEW_SECONDS=300
BARAQ_HMAC_NONCE_TTL_SECONDS=600
AI_SERVICE_VERIFY_SSL=True
AI_SERVICE_ALLOW_INSECURE_HTTP=False
AI_SERVICE_TIMEOUT_SECONDS=30
AI_DATASET_CONSENT_VERSION=2026-07-01

# Payments are deliberately disabled until a verified provider adapter,
# webhook replay suite, and reconciliation process are deployed.
PAYMENTS_ENABLED=False

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
CORS_ALLOW_CREDENTIALS=False
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=14
API_DOCS_PUBLIC=False

# Uploads and storage
STUDENT_SOURCE_MAX_UPLOAD_MB=50
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Mail, password reset, and registration email-OTP. Use a transactional
# provider/domain that you control; consumer mailbox SMTP accounts are not a
# production deliverability strategy. Keep credentials only in the deploy
# target's secret store, never in this file.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.transactional-provider.example
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Baraq <no-reply@baraqapp.com>
# Where the password-reset email's link points. The web app's reset page
# (web/src/app/[locale]/(auth)/reset-password/page.tsx) reads the exact same
# `?uid=&token=` query pair Django appends here, so this can point at either
# surface -- it is a single global value, not per-client, so pick the one
# production actually wants users to land on:
#   - Web (recommended once web.baraqapp.com is deployed): https://web.baraqapp.com/ar/reset-password
#   - Mobile-only (no web deployment yet): baraq://reset-password
FRONTEND_PASSWORD_RESET_URL=https://web.baraqapp.com/ar/reset-password
PASSWORD_RESET_TIMEOUT=3600

# Throttling
THROTTLE_ANON=60/hour
THROTTLE_USER=2000/day
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=10/minute
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOADS=30/hour
THROTTLE_AI=100/day
THROTTLE_WAITLIST=5/hour

# Runtime / observability
# APP_PORT is only used by the ops team's compose.yaml for the host-side port
# mapping ("127.0.0.1:${HOST_PORT}:${APP_PORT}"); the container's own gunicorn
# process actually binds PORT (see Dockerfile/gunicorn.conf.py). Keep these
# two equal -- if you ever change one to move the internal port, change both.
APP_PORT=8000
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# entrypoint.sh behavior. For a standalone single-container run, leave both
# migrate/collectstatic on (migrate is idempotent, collectstatic overwrites
# the same manifest deterministically). The real deployed stack (root
# compose.yaml) instead runs a dedicated one-shot `backend-migrate` service
# and sets these to "0" on `backend`/`backend-worker`/`backend-worker-
# critical`/`backend-beat`, so replicas never race to migrate concurrently.
DJANGO_WAIT_FOR_DATABASE=1
DJANGO_RUN_MIGRATIONS=1
DJANGO_COLLECTSTATIC=1
